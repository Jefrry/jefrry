{$SITE_ADDRESS:jefrry.dev} {
	root * /srv
	encode zstd gzip

	# Revalidate HTML, payloads, unversioned images, PDF and build metadata.
	header ?Cache-Control "no-cache"
	@versioned {
		path_regexp ^/_nuxt/([^/]+\.)?[A-Za-z0-9_-]{8}\.(js|css|woff|woff2)$
		file {path}
	}
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	# Directory indexes also provide canonical trailing-slash redirects.
	file_server {
		index index.html
	}

	handle_errors 404 {
		header Cache-Control "no-cache"
		rewrite * /404.html
		file_server
	}
}
